# ── parley — environment template (copy to .env; .env is git-ignored) ─────
# No secret values live in the repo (R11). Every secret is read via
# os.environ.get and injected through the Gatekeeper.

# ── MCP server Bearer tokens (H8 — token auth, not passwords; revocable) ──
PARLEY_COP_TOKEN=replace-with-long-random-string
PARLEY_THIEF_TOKEN=replace-with-another-long-random-string

# ── LLM provider ─────────────────────────────────────────────────────────
# Default provider is the Claude CLI subscription (no API key needed).
# The orchestrator shells out to the `claude` binary via the Gatekeeper.
PARLEY_CLAUDE_CLI_BIN=claude
# Ollama fallback (local, free). Only used when llm.provider = "ollama".
PARLEY_OLLAMA_BASE_URL=http://localhost:11434

# ── Report sender ────────────────────────────────────────────────────────
# Gmail API (OAuth) — paths to OAuth client + cached token (both git-ignored).
PARLEY_GMAIL_CREDENTIALS=credentials.json
PARLEY_GMAIL_TOKEN=token.json
# SMTP fallback (used when report.sender = "smtp").
PARLEY_SMTP_HOST=smtp.gmail.com
PARLEY_SMTP_PORT=587
PARLEY_SMTP_USER=you@example.com
PARLEY_SMTP_PASSWORD=app-specific-password
PARLEY_REPORT_FROM=you@example.com

# ── ngrok remote deploy (optional; H8 cloud execution) ───────────────────
NGROK_AUTHTOKEN=your-ngrok-authtoken
